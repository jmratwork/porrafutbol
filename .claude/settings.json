{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.npmrc)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(npm publish:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npm run db:push:*)",
      "Bash(vercel:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm audit fix:*)",
      "Bash(rm:*)"
    ]
  }
}
